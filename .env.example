# ==============================
# APP CONFIG
# ==============================
NODE_ENV=development
PORT=8000
API_PREFIX=api

# ==============================
# FRONTEND
# ==============================
APP_ORIGINS=http://localhost:5173,https://example.com,https://www.example.com

# URL pública de este backend (para whitelistear en URLFilterRules del .seb de Safe Exam
# Browser). Opcional: si no se define, se infiere del origin de GOOGLE_CALLBACK_URL.
API_URL=https://your-api-domain.com

# ==============================
# DATABASE (PostgreSQL)
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Crear tablas automáticamente
TYPEORM_SYNC=true

# ==============================
# JWT
# ==============================
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=jwt

# Dominio explícito de la cookie JWT cuando frontend y backend están en subdominios
# distintos del mismo dominio raíz (p.ej. ".your-domain.com" para cubrir tanto
# your-domain.com como api.your-domain.com). Requerido en producción: sin esto, algunos
# navegadores embebidos (p.ej. Safe Exam Browser) no envían la cookie en peticiones
# cross-subdominio. Déjalo vacío en desarrollo local.
COOKIE_DOMAIN=.your-domain.com

# ==============================
# SEED
# ==============================
# Ejecuta seed al arrancar
RUN_SEED=true

# ==============================
# FILE STORAGE
# ==============================
UPLOAD_DIR=uploads

# ==============================
# VIDEO STREAMING
# ==============================
VIDEO_DIR=videos

# ==============================
# PLAYGROUND EXECUTION (Piston)
# ==============================
PISTON_URL=http://localhost:2000/api/v2/piston

# ==============================
# PLAYGROUND EXECUTION
# ==============================
PREFER_DIRECT_EXECUTION=true

# ==============================
# GOOGLE OAUTH
# ==============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-api-domain.com/auth/google/callback
FRONTEND_URL=https://your-frontend-domain.com